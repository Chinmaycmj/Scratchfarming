{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TERRAFORM // Run Streamlit HUD",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.port=8501",
                "--server.headless=false"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
